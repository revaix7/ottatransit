# Copy this file to server/.env and fill in your key.
# Free key from https://nextrip-public-api.developer.azure-api.net (OC Transpo dev portal).
OC_TRANSPO_API_KEY=

# Port for the Express API. Defaults to 3000; override if something else
# already holds that port. Keep it in sync with nothing else — vite.config.js
# reads this file to point its /api proxy at the right place.
PORT=3001
